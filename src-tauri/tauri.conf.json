{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal Deck",
  "version": "0.4.0",
  "identifier": "local.toubi.terminal-deck",
  "build": {
    "beforeBuildCommand": "node scripts/build-tauri.cjs",
    "beforeDevCommand": "node scripts/build-tauri.cjs",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Terminal Deck",
        "url": "src/index.html",
        "width": 1520,
        "height": 960,
        "minWidth": 920,
        "minHeight": 620,
        "backgroundColor": "#050505",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
